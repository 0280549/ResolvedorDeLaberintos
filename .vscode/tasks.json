{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/std:c++17",
                "/Zi",
                "/EHsc",
                "/nologo",
                "/utf-8",
                "/MD",
                "/IC:\\raylib\\raylib\\src",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}",
                "/link",
                "/LIBPATH:C:\\raylib\\raylib\\build\\raylib\\Release",
                "raylib.lib",
                "opengl32.lib",
                "gdi32.lib",
                "winmm.lib",
                "user32.lib",
                "shell32.lib"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila el archivo activo con cl.exe, C++17 y raylib."
        }
    ],
    "version": "2.0.0"
}